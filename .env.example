# Copy to .env to override docker-compose defaults. Not required to run
# `docker compose up` -- every value below has a working default.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=experiment_copilot

# Change this for anything beyond local development.
SECRET_KEY=dev-secret-key-change-me
ALGORITHM=HS512

# Origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Where the frontend (running in the user's browser) should reach the API.
# Only relevant if you remap the "api" service's published port.
FRONTEND_API_URL=http://localhost:8000
