# Copy to .env before running `docker compose up` -- POSTGRES_PASSWORD and
# SECRET_KEY are required (compose fails fast with a clear error if either
# is missing), so nothing here is a usable credential by itself.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-own-password
POSTGRES_DB=experiment_copilot

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-generated-secret
ALGORITHM=HS512

# Origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Host ports. Change any of these if something else on your machine already
# uses the default (e.g. a native Postgres install already on 5432).
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=3000

# Where the frontend (running in the user's browser) should reach the API.
# Update this to match API_PORT if you change it above.
FRONTEND_API_URL=http://localhost:8000
